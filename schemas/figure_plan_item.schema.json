{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figure_plan_item.schema.json",
  "title": "FigurePlanItem",
  "type": "object",
  "properties": {
    "label": { "type": "string" },
    "source_figure": { "type": "string" },
    "panels": { "type": ["string", "null"], "default": null },
    "placement_after_section": { "type": ["string", "null"], "default": null },
    "reason": { "type": "string" },
    "image_path": { "type": ["string", "null"], "default": null }
  },
  "required": ["label", "source_figure", "reason"],
  "additionalProperties": false
}
