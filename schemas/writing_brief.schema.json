{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "writing_brief.schema.json",
  "title": "WritingBrief",
  "type": "object",
  "properties": {
    "target_word_count": { "type": "integer", "minimum": 1 },
    "target_section_count": { "type": "integer", "minimum": 1 },
    "target_figure_count": { "type": "integer", "minimum": 0 },
    "reference_profile": {
      "anyOf": [
        { "$ref": "reference_profile.schema.json" },
        { "type": "null" }
      ],
      "default": null
    },
    "instructions": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["target_word_count", "target_section_count", "target_figure_count"],
  "additionalProperties": false
}
