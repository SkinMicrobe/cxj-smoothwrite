{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference_profile.schema.json",
  "title": "ReferenceProfile",
  "type": "object",
  "properties": {
    "source_docx": { "type": "string" },
    "text": { "type": "string" },
    "character_count": { "type": "integer", "minimum": 0 },
    "paragraph_count": { "type": "integer", "minimum": 0 },
    "section_headings": { "type": "array", "items": { "type": "string" } },
    "image_count": { "type": "integer", "minimum": 0 },
    "page_count_hint": { "type": ["integer", "null"], "minimum": 0, "default": null }
  },
  "required": ["source_docx", "text", "character_count", "paragraph_count"],
  "additionalProperties": false
}
