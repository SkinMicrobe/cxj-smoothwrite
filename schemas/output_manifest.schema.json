{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output_manifest.schema.json",
  "title": "OutputManifest",
  "type": "object",
  "properties": {
    "pdf_path": { "type": "string" },
    "output_dir": { "type": "string" },
    "parsed_pdf_json": { "type": ["string", "null"], "default": null },
    "article_md": { "type": ["string", "null"], "default": null },
    "final_docx": { "type": ["string", "null"], "default": null },
    "metadata_json": { "type": ["string", "null"], "default": null },
    "article_plan_json": { "type": ["string", "null"], "default": null },
    "figure_plan_json": { "type": ["string", "null"], "default": null },
    "figures_dir": { "type": ["string", "null"], "default": null },
    "figure_manifest_json": { "type": ["string", "null"], "default": null },
    "review_notes_md": { "type": ["string", "null"], "default": null },
    "output_manifest_json": { "type": ["string", "null"], "default": null },
    "reference_article_txt": { "type": ["string", "null"], "default": null },
    "writing_brief_json": { "type": ["string", "null"], "default": null },
    "review_notes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "required": ["pdf_path", "output_dir"],
  "additionalProperties": false
}
